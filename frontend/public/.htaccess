<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and non-www domain in a single hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://miraitechnologies.net/$1 [R=301,L]

  # 2. Redirect duplicate categories and consolidating IC slugs
  RewriteRule ^products/integrated-circuits/?$ /products/integrated-circuit [R=301,L,NC]
  RewriteRule ^product/(ic-chip|integrated-circuits|ic)/(.*)$ /product/integrated-circuit/$2 [R=301,L,NC]

  # 3. Aliases for RFQ and BOM upload
  RewriteRule ^(rfq|bom-upload|quote|request-a-quote)/?$ /contact [R=301,L,NC]

  # 3. Strip trailing slashes (except for physical directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 4. Redirect legacy .php pages
  RewriteRule ^index\.php$ / [R=301,L,NC]
  RewriteRule ^about\.php$ /about [R=301,L,NC]
  RewriteRule ^products\.php$ /products [R=301,L,NC]
  RewriteRule ^contact\.php$ /contact [R=301,L,NC]
  RewriteRule ^brands\.php$ /about [R=301,L,NC]

  # 5. Redirect /sitemap to /sitemap.xml
  RewriteRule ^sitemap$ /sitemap.xml [R=301,L]

  # 5b. Redirect legacy duplicate city-product URLs and old city names
  RewriteRule ^(power-mosfets-supplier-chennai|integrated-circuits-supplier-chennai)/?$ /electronic-component-distributor-in-chennai [R=301,L,NC]
  RewriteRule ^power-mosfets-supplier-coimbatore/?$ /electronic-component-distributor-in-coimbatore [R=301,L,NC]
  RewriteRule ^(power-mosfets-supplier-mumbai|igbts-supplier-mumbai|integrated-circuits-supplier-mumbai|microcontrollers-supplier-mumbai|transistors-optocouplers-supplier-mumbai|voltage-regulators-supplier-mumbai|diodes-rectifiers-supplier-mumbai)/?$ /electronic-component-distributor-in-mumbai [R=301,L,NC]
  RewriteRule ^(power-mosfets-supplier-pune|igbts-supplier-pune)/?$ /electronic-component-distributor-in-pune [R=301,L,NC]
  RewriteRule ^(electronic-component-distributor-in-aurangabad|aurangabad)/?$ /electronic-component-distributor-in-chhatrapati-sambhajinagar [R=301,L,NC]

  # 6. SPA Routing fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
